{
  "name": "kedgeway",
  "version": "0.2.0",
  "private": false,
  "description": "Diagnose how outdated a Stellar/Soroban repo toolchain is, grounded on live ecosystem data from Stellar Raven",
  "license": "MIT",
  "homepage": "https://kedgeway.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klorenn/kedgeway.git"
  },
  "bugs": {
    "url": "https://github.com/Klorenn/kedgeway/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "sdk",
    "cli",
    "raven",
    "toolchain"
  ],
  "type": "module",
  "bin": {
    "kedgeway": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
